---
import Layout from "../components/Layout.astro";
import { siteConfig } from "../config/site";
import {
    getCuchillos,
    getGaleria,
    getTaller,
    getMateriales,
} from "../lib/data";
import { resolveImage } from "../lib/imageHelper";
import KnifeCard from "../components/KnifeCard.astro";

const cuchillos = getCuchillos();
const galeria = getGaleria();
const taller = getTaller();
const materiales = getMateriales();

const materialesAgrupados = materiales.reduce(
    (acc, mat) => {
        if (!acc[mat.categoria]) acc[mat.categoria] = [];
        acc[mat.categoria].push(mat);
        return acc;
    },
    {} as Record<string, typeof materiales>,
);

const getUniqueValues = (key: string) => {
    const values = new Map<string, number>();
    cuchillos.forEach((c) => {
        const val =
            (c as any)[key]?.toString().toLowerCase() || "sin especificar";
        values.set(val, (values.get(val) || 0) + 1);
    });
    return Array.from(values.entries()).sort((a, b) => b[1] - a[1]);
};

const aceros = getUniqueValues("acero");
const cabos = getUniqueValues("cabo");
const terminaciones = getUniqueValues("terminacion");
const estados = getUniqueValues("estado");

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Store",
    name: siteConfig.name,
    description: siteConfig.rubro,
    url: siteConfig.url,
    telephone: `+${siteConfig.whatsapp}`,
    address: {
        "@type": "PostalAddress",
        streetAddress: "Av. Mitre 1010",
        addressLocality: "Junín",
        addressRegion: "Mendoza",
        postalCode: "5573",
        addressCountry: "AR",
    },
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "08:00",
            closes: "20:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: "Saturday",
            opens: "08:00",
            closes: "14:00",
        },
    ],
    sameAs: [siteConfig.instagram, siteConfig.facebook],
};
---

<Layout
    title="Inicio"
    description={`${siteConfig.name}. ${siteConfig.gancho} Cuchillería artesanal en Junín, Mendoza. Stock y por encargo.`}
    {jsonLd}
>
    <!-- HERO -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
        <h1 class="text-4xl md:text-5xl font-serif mb-4 text-charcoal">
            {siteConfig.gancho}
        </h1>
        <p class="text-lg text-charcoal/80 mb-8 max-w-2xl mx-auto">
            Cuchillería artesanal en Junín, Mendoza. Trabajamos en stock y por
            encargo.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#productos" class="btn-primary">
                Ver cuchillos
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-cream/20">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </span>
            </a>
            <a
                href={`https://wa.me/${siteConfig.whatsapp}?text=Hola,%20quiero%20cotizar%20un%20cuchillo.`}
                target="_blank"
                rel="noopener"
                class="btn-secondary"
            >
                Cotizar por WhatsApp
            </a>
        </div>
    </section>

    <!-- PRODUCTOS -->
    <section
        id="productos"
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-charcoal/10"
    >
        <div class="flex flex-col md:flex-row gap-8">
            <aside class="w-full md:w-64 flex-shrink-0">
                <div class="flex items-center justify-between md:hidden mb-4">
                    <h2 class="font-serif text-xl">Filtros</h2>
                    <button
                        id="toggle-filters"
                        class="text-sm text-cognac font-medium"
                    >
                        Mostrar/Ocultar
                    </button>
                </div>

                <div
                    id="filter-panel"
                    class="hidden md:block space-y-6 bg-cream p-4 rounded-lg border border-charcoal/10"
                >
                    <div>
                        <h3 class="font-medium text-sm uppercase tracking-wider text-charcoal/60 mb-2">
                            Estado
                        </h3>
                        <div class="space-y-1">
                            {estados.map(([val, count]) => (
                                <label class="flex items-center gap-2 text-sm cursor-pointer hover:text-cognac transition-colors">
                                    <input
                                        type="checkbox"
                                        class="filter-input rounded border-charcoal/30 text-cognac focus:ring-cognac"
                                        data-type="estado"
                                        value={val}
                                    />
                                    <span class="capitalize">{val}</span>
                                    <span class="text-charcoal/40 text-xs">
                                        ({count})
                                    </span>
                                </label>
                            ))}
                        </div>
                    </div>
                    <div>
                        <h3 class="font-medium text-sm uppercase tracking-wider text-charcoal/60 mb-2">
                            Acero
                        </h3>
                        <div class="space-y-1 max-h-40 overflow-y-auto">
                            {aceros.map(([val, count]) => (
                                <label class="flex items-center gap-2 text-sm cursor-pointer hover:text-cognac transition-colors">
                                    <input
                                        type="checkbox"
                                        class="filter-input rounded border-charcoal/30 text-cognac focus:ring-cognac"
                                        data-type="acero"
                                        value={val}
                                    />
                                    <span class="capitalize">{val}</span>
                                    <span class="text-charcoal/40 text-xs">
                                        ({count})
                                    </span>
                                </label>
                            ))}
                        </div>
                    </div>
                    <div>
                        <h3 class="font-medium text-sm uppercase tracking-wider text-charcoal/60 mb-2">
                            Cabo
                        </h3>
                        <div class="space-y-1 max-h-40 overflow-y-auto">
                            {cabos.map(([val, count]) => (
                                <label class="flex items-center gap-2 text-sm cursor-pointer hover:text-cognac transition-colors">
                                    <input
                                        type="checkbox"
                                        class="filter-input rounded border-charcoal/30 text-cognac focus:ring-cognac"
                                        data-type="cabo"
                                        value={val}
                                    />
                                    <span class="capitalize">{val}</span>
                                    <span class="text-charcoal/40 text-xs">
                                        ({count})
                                    </span>
                                </label>
                            ))}
                        </div>
                    </div>
                    <div>
                        <h3 class="font-medium text-sm uppercase tracking-wider text-charcoal/60 mb-2">
                            Terminación
                        </h3>
                        <div class="space-y-1 max-h-40 overflow-y-auto">
                            {terminaciones.map(([val, count]) => (
                                <label class="flex items-center gap-2 text-sm cursor-pointer hover:text-cognac transition-colors">
                                    <input
                                        type="checkbox"
                                        class="filter-input rounded border-charcoal/30 text-cognac focus:ring-cognac"
                                        data-type="terminacion"
                                        value={val}
                                    />
                                    <span class="capitalize">{val}</span>
                                    <span class="text-charcoal/40 text-xs">
                                        ({count})
                                    </span>
                                </label>
                            ))}
                        </div>
                    </div>
                    <button
                        id="clear-filters"
                        class="w-full text-xs text-cognac underline hover:text-charcoal transition-colors"
                    >
                        Limpiar filtros
                    </button>
                </div>
            </aside>

            <div class="flex-1">
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
                    {cuchillos.map((c) => (
                        <KnifeCard cuchillo={c} />
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- GALERÍA -->
    <section
        id="galeria"
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-charcoal/10"
    >
        <h2 class="text-3xl font-serif mb-2 text-center">
            Trabajos realizados
        </h2>
        <p class="text-center text-charcoal/60 text-sm mb-8">
            (No están a la venta, se pueden hacer por encargo)
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {galeria.map((item) => (
                <button
                    class="gallery-trigger relative aspect-square group overflow-hidden rounded-lg bg-cream"
                    data-name={item.nombre}
                    data-desc={item.descripcion || ""}
                >
                    <img
                        src={resolveImage("galeria", item.foto)}
                        alt={item.nombre}
                        width="400"
                        height="400"
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-black/50 flex items-end p-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <span class="text-cream font-medium text-sm text-left">
                            {item.nombre}
                        </span>
                    </div>
                </button>
            ))}
        </div>
    </section>

    <!-- INFORMACIÓN ÚTIL -->
    <section
        id="info"
        class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-charcoal/10"
    >
        <h2 class="text-3xl font-serif mb-8 text-center">Información útil</h2>
        <div class="space-y-4">
            <details class="bg-cream p-5 rounded-lg border border-charcoal/10 group">
                <summary class="font-serif text-xl cursor-pointer list-none flex justify-between items-center">
                    Cuidados y mantenimiento
                    <span class="text-cognac transition-transform group-open:rotate-180">
                        ▼
                    </span>
                </summary>
                <div class="mt-4 text-charcoal/80 space-y-3 text-sm leading-relaxed">
                    <p>
                        <strong>Limpieza y secado:</strong> Lavalos y secalos
                        apenas termines de usarlos. El agua y la humedad son los
                        principales enemigos del acero al carbono. Secalos bien
                        con un paño.
                    </p>
                    <p>
                        <strong>Aceite:</strong> Antes de guardarlos por un
                        tiempo, pasales una capa fina de aceite mineral, de
                        camelia o de cocina. Esto crea una barrera contra la
                        oxidación.
                    </p>
                    <p>
                        <strong>Guardado:</strong> Guárdalos en un lugar seco.
                        Si tienen vaina de cuero, asegurate de que tanto el
                        cuchillo como la vaina estén perfectamente secos antes
                        de enfundarlos.
                    </p>
                    <p>
                        <strong>Vaina de cuero:</strong> El cuero necesita
                        hidratación. Cada tanto, aplicale una capa de grasa de
                        caballo, neatsfoot oil o crema para cuero para que no se
                        reseque ni se agriete.
                    </p>
                </div>
            </details>

            <details class="bg-cream p-5 rounded-lg border border-charcoal/10 group">
                <summary class="font-serif text-xl cursor-pointer list-none flex justify-between items-center">
                    Tipos de afilado
                    <span class="text-cognac transition-transform group-open:rotate-180">
                        ▼
                    </span>
                </summary>
                <div class="mt-4 text-charcoal/80 space-y-3 text-sm leading-relaxed">
                    <p>
                        <strong>Filo plano (V):</strong> El más común. Versátil
                        y fácil de mantener. Se afila manteniendo un ángulo
                        constante (generalmente entre 15° y 20°) sobre la
                        piedra.
                    </p>
                    <p>
                        <strong>Scandi:</strong> Típico de cuchillos de monte y
                        bushcraft. Tiene un bisel ancho y robusto, muy
                        resistente para trabajar madera. Se afila apoyando todo
                        el bisel plano sobre la piedra.
                    </p>
                    <p>
                        <strong>Convexo:</strong> El filo se curva hacia afuera.
                        Es extremadamente duradero y resistente a astillados,
                        ideal para hachas y cuchillos de trabajo pesado. Se
                        afila con piedras flexibles o cuero con pasta.
                    </p>
                    <p>
                        <strong>Cómo afilar:</strong> Usá piedras de agua o de
                        diamante. Empezá con un grano medio (400-1000) para
                        reparar el filo y terminá con uno fino (3000-8000) para
                        pulirlo. Mantener el ángulo original es la clave.
                    </p>
                </div>
            </details>

            <details class="bg-cream p-5 rounded-lg border border-charcoal/10 group">
                <summary class="font-serif text-xl cursor-pointer list-none flex justify-between items-center">
                    Seguridad y uso
                    <span class="text-cognac transition-transform group-open:rotate-180">
                        ▼
                    </span>
                </summary>
                <div class="mt-4 text-charcoal/80 space-y-3 text-sm leading-relaxed">
                    <p>
                        Un cuchillo bien afilado es más seguro que uno
                        desafilado, porque requiere menos fuerza y controlás
                        mejor el corte.
                    </p>
                    <p>
                        Cortá siempre alejando el filo de tu cuerpo y de tus
                        manos. Usá una superficie estable.
                    </p>
                    <p>
                        No los uses como palanca o destornillador; el acero de
                        los cuchillos es duro pero frágil a la torsión y puede
                        quebrarse.
                    </p>
                    <p>
                        Mantenelos fuera del alcance de los niños. Usá fundas o
                        bloques magnéticos para guardarlos.
                    </p>
                </div>
            </details>
        </div>
    </section>

    <!-- CÓMO COMPRAR -->
    <section
        id="comprar"
        class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-charcoal/10"
    >
        <h2 class="text-3xl font-serif mb-8 text-center">Cómo comprar</h2>
        <div class="grid md:grid-cols-2 gap-8 mb-12">
            <div class="space-y-6">
                <div class="flex gap-4">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-cognac text-cream flex items-center justify-center font-bold">
                        1
                    </span>
                    <div>
                        <h3 class="font-serif text-lg mb-1">
                            Elegí o contanos tu idea
                        </h3>
                        <p class="text-sm text-charcoal/70">
                            Revisá el catálogo o describinos el cuchillo que
                            tenés en mente (uso, tamaño, materiales preferidos).
                        </p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-cognac text-cream flex items-center justify-center font-bold">
                        2
                    </span>
                    <div>
                        <h3 class="font-serif text-lg mb-1">
                            Coordinamos por WhatsApp
                        </h3>
                        <p class="text-sm text-charcoal/70">
                            Definimos juntos los detalles, el precio final y los
                            tiempos estimados de trabajo.
                        </p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-cognac text-cream flex items-center justify-center font-bold">
                        3
                    </span>
                    <div>
                        <h3 class="font-serif text-lg mb-1">Pago y entrega</h3>
                        <p class="text-sm text-charcoal/70">
                            Acordamos la forma de pago. Te avisamos cuando está
                            listo para coordinar el envío a todo el país o el
                            retiro en el taller.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-cream p-6 rounded-lg border border-charcoal/10">
                <h3 class="font-serif text-xl mb-4">Materiales disponibles</h3>
                <div class="space-y-3">
                    {Object.entries(materialesAgrupados).map(([cat, mats]) => (
                        <details class="border-b border-charcoal/10 pb-2">
                            <summary class="font-medium text-sm cursor-pointer py-2 flex justify-between items-center">
                                {cat}
                                <span class="text-cognac text-xs">▼</span>
                            </summary>
                            <ul class="pl-4 pb-2 space-y-1">
                                {mats
                                    .filter((m) => m.disponible)
                                    .map((m) => (
                                        <li class="text-sm text-charcoal/80">
                                            <strong>{m.nombre}:</strong>{" "}
                                            {m.nota}
                                        </li>
                                    ))}
                            </ul>
                        </details>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACTO -->
    <section
        id="contacto"
        class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-charcoal/10"
    >
        <h2 class="text-3xl font-serif mb-8 text-center">Contacto</h2>
        <div class="grid md:grid-cols-2 gap-12">
            <div class="space-y-6">
                <div>
                    <h3 class="font-serif text-lg mb-2">Dónde estamos</h3>
                    <p class="text-sm text-charcoal/80">
                        {siteConfig.direccion}
                    </p>
                    <a
                        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteConfig.direccion)}`}
                        target="_blank"
                        rel="noopener"
                        class="text-cognac text-sm underline mt-1 inline-block"
                    >
                        Cómo llegar en Google Maps
                    </a>
                    <p class="text-xs text-charcoal/50 mt-2 italic">
                        Coordiná tu visita por WhatsApp antes de pasar.
                    </p>
                </div>
                <div>
                    <h3 class="font-serif text-lg mb-2">Horarios</h3>
                    <p class="text-sm text-charcoal/80">
                        {siteConfig.horarios}
                    </p>
                </div>
                <div>
                    <h3 class="font-serif text-lg mb-2">Escribinos</h3>
                    <ul class="text-sm space-y-2">
                        <li>
                            WhatsApp:{" "}
                            <a
                                href={`https://wa.me/${siteConfig.whatsapp}`}
                                class="text-cognac hover:underline"
                            >
                                +{siteConfig.whatsapp}
                            </a>
                        </li>
                        <li>
                            Email:{" "}
                            <a
                                href={`mailto:${siteConfig.email}`}
                                class="text-cognac hover:underline"
                            >
                                {siteConfig.email}
                            </a>
                        </li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-serif text-lg mb-2">Seguinos</h3>
                    <div class="flex gap-4">
                        <a
                            href={siteConfig.instagram}
                            target="_blank"
                            rel="noopener"
                            class="text-charcoal hover:text-cognac transition-colors"
                            aria-label="Instagram"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <rect
                                    x="2"
                                    y="2"
                                    width="20"
                                    height="20"
                                    rx="5"
                                    ry="5"
                                ></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line
                                    x1="17.5"
                                    y1="6.5"
                                    x2="17.51"
                                    y2="6.5"
                                ></line>
                            </svg>
                        </a>
                        <a
                            href={siteConfig.facebook}
                            target="_blank"
                            rel="noopener"
                            class="text-charcoal hover:text-cognac transition-colors"
                            aria-label="Facebook"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="bg-cream p-6 rounded-lg border border-charcoal/10">
                <h3 class="font-serif text-xl mb-4">Envianos un mensaje</h3>
                <form id="contact-form" class="space-y-4">
                    <div>
                        <label
                            for="c-name"
                            class="block text-xs font-medium text-charcoal/60 mb-1"
                        >
                            Nombre *
                        </label>
                        <input
                            type="text"
                            id="c-name"
                            required
                            class="w-full px-3 py-2 rounded border border-charcoal/20 bg-white focus:outline-none focus:border-cognac text-sm"
                        />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label
                                for="c-email"
                                class="block text-xs font-medium text-charcoal/60 mb-1"
                            >
                                Email *
                            </label>
                            <input
                                type="email"
                                id="c-email"
                                required
                                class="w-full px-3 py-2 rounded border border-charcoal/20 bg-white focus:outline-none focus:border-cognac text-sm"
                            />
                        </div>
                        <div>
                            <label
                                for="c-phone"
                                class="block text-xs font-medium text-charcoal/60 mb-1"
                            >
                                Teléfono (opcional)
                            </label>
                            <input
                                type="tel"
                                id="c-phone"
                                class="w-full px-3 py-2 rounded border border-charcoal/20 bg-white focus:outline-none focus:border-cognac text-sm"
                            />
                        </div>
                    </div>
                    <div>
                        <label
                            for="c-msg"
                            class="block text-xs font-medium text-charcoal/60 mb-1"
                        >
                            Mensaje (opcional)
                        </label>
                        <textarea
                            id="c-msg"
                            rows="3"
                            class="w-full px-3 py-2 rounded border border-charcoal/20 bg-white focus:outline-none focus:border-cognac text-sm"
                        ></textarea>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3 pt-2">
                        <button
                            type="button"
                            id="btn-wa"
                            class="btn-primary flex-1 text-sm py-2"
                        >
                            Enviar por WhatsApp
                        </button>
                        <button
                            type="button"
                            id="btn-email"
                            class="btn-secondary flex-1 text-sm py-2"
                        >
                            Enviar por email
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- TALLER -->
    <section
        id="taller"
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-charcoal/10"
    >
        <h2 class="text-3xl font-serif mb-8 text-center">Taller</h2>
        <div class="columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4">
            {taller.map((item) => (
                <div class="break-inside-avoid mb-4 bg-cream rounded-lg border border-charcoal/10 overflow-hidden">
                    {item.tipo === "foto" ? (
                        <img
                            src={resolveImage("taller", item.archivo || "")}
                            alt={item.alt}
                            width="400"
                            height="400"
                            loading="lazy"
                            class="w-full h-auto"
                        />
                    ) : (
                        <div
                            class="video-facade relative aspect-video bg-dark cursor-pointer group"
                            data-url={item.url}
                        >
                            <img
                                src={`https://img.youtube.com/vi/${item.url?.split("v=")[1] || item.url?.split("/").pop()}/hqdefault.jpg`}
                                alt={item.alt}
                                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                            />
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-12 h-12 rounded-full bg-cognac/90 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="white"
                                        stroke="white"
                                        stroke-width="1"
                                    >
                                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    )}
                    <div class="p-3">
                        <h3 class="font-serif text-sm font-semibold text-charcoal">
                            {item.titulo}
                        </h3>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- MODAL CUCHILLO -->
    <dialog
        id="knife-modal"
        class="w-full max-w-4xl p-0 rounded-lg shadow-2xl border-0 bg-cream backdrop:bg-black/50 open:animate-fade-in"
    >
        <div class="relative">
            <button
                id="close-modal"
                class="absolute top-4 right-4 z-10 bg-white/80 p-2 rounded-full hover:bg-white transition-colors"
                aria-label="Cerrar"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div
                id="modal-content-inner"
                class="max-h-[90vh] overflow-y-auto"
            ></div>
        </div>
    </dialog>

    <!-- LIGHTBOX GALERÍA -->
    <div
        id="gallery-lightbox"
        class="fixed inset-0 z-[60] bg-black/90 hidden flex items-center justify-center p-4"
    >
        <button
            id="close-gallery"
            class="absolute top-4 right-4 text-white p-2 hover:text-cognac transition-colors"
            aria-label="Cerrar"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <div class="max-w-3xl w-full text-center">
            <img
                id="gallery-img"
                src=""
                alt=""
                class="max-h-[75vh] mx-auto rounded-lg shadow-2xl"
            />
            <p
                id="gallery-caption"
                class="text-cream mt-4 text-lg font-serif"
            ></p>
            <a
                id="gallery-wa"
                href=""
                target="_blank"
                rel="noopener"
                class="btn-primary mt-6 inline-block"
            >
                Encargar uno así
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-cream/20">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </span>
            </a>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="../scripts/catalog.ts"></script>
    <script src="../scripts/main.ts"></script>
</Layout>
